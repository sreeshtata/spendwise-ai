# ========================================================
# SpendWise AI — Environment Variables Template
# Placeholders only. Copy to .env for custom credentials.
# Without credentials, the application defaults to deterministic
# high-fidelity demo & local fallback fixtures.
# ========================================================

# Application Configuration
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001/api/v1
VITE_BASE_PATH=/

# PayPal Sandbox Credentials (for live sandbox payments)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Channel3 E-Commerce API (for live discovery)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_ENDPOINT=https://api.channel3.ai/v1

# AI Intelligence Service (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Elasticsearch Search Engine
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password
